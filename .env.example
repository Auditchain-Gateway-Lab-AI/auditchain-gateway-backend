# Copy this file to .env for local development. Never commit the real .env.

PORT=8080
DB_DSN=postgres://postgres:password@localhost:5433/test_blockchain?sslmode=disable
JWT_SECRET=replace-with-a-long-local-secret
ADMIN_SECRET=replace-with-a-long-admin-secret

# Optional ingestion/queue configuration used by the active deployment.
INGESTION_API_KEY=replace-with-an-ingestion-key
REDIS_HOST=localhost:6379
REDIS_PASSWORD=replace-with-a-redis-password
REDIS_DB=0

# Hyperledger Fabric connection paths are host/container paths, not secrets.
# Keep the referenced certificates and private key outside Git.
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=peer0.org1.audit.example.com:7051
FABRIC_TLS_CERT_PATH=/home/besu/audit_blockchain/organizations/peerOrganizations/org1.audit.example.com/peers/peer0.org1.audit.example.com/tls/ca.crt
FABRIC_CERT_PATH=/home/besu/audit_blockchain/organizations/peerOrganizations/org1.audit.example.com/users/User1@org1.audit.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/home/besu/audit_blockchain/organizations/peerOrganizations/org1.audit.example.com/users/User1@org1.audit.example.com/msp/keystore/priv_sk
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=auditchain

# Tailscale is only needed when the application reaches private client brokers.
TAILSCALE_API_TOKEN=replace-with-a-tailscale-api-token
TAILSCALE_TAILNET=replace-with-a-tailnet

# MinIO local defaults. Replace all passwords before staging/production.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-local-root-password
MINIO_BUCKET=auditchain-recovery
MINIO_WRITER_USER=auditchain-writer
MINIO_WRITER_PASSWORD=replace-local-writer-password
MINIO_READER_USER=auditchain-reader
MINIO_READER_PASSWORD=replace-local-reader-password
# Runtime credentials when Gateway is started outside Compose (`go run main.go`).
MINIO_ACCESS_KEY=auditchain-writer
MINIO_SECRET_KEY=replace-local-writer-password
MINIO_RETENTION_MODE=COMPLIANCE
MINIO_RETENTION_DAYS=30
MINIO_USE_TLS=false
APP_ENV=local

# 32-byte key in base64 or 64 hexadecimal characters.
SNAPSHOT_ENCRYPTION_ACTIVE_KEY_ID=key-2026-01
SNAPSHOT_ENCRYPTION_KEY=replace-with-base64-or-hex-32-byte-key

# Recovery feature flags (enabled only after the implementation is complete).
RECOVERY_ENABLED=false
# UTC deployment boundary. Rows created before this instant are legacy:
# they remain verifiable but are intentionally not recoverable from MinIO.
RECOVERY_CUTOFF_AT=
SNAPSHOT_WRITER_ENABLED=false
# Set true together with RECOVERY_ENABLED=true in staging/production.
SNAPSHOT_REQUIRED_FOR_ANCHOR=false
TAMPER_SCANNER_ENABLED=false
TAMPER_SCAN_INTERVAL_SECONDS=300
TAMPER_SCAN_BATCH_SIZE=100
TAMPER_SCAN_CONCURRENCY=2
SNAPSHOT_WORKER_CONCURRENCY=1
SNAPSHOT_MAX_ATTEMPTS=10
SNAPSHOT_RETRY_BASE_SECONDS=5
SNAPSHOT_POLL_INTERVAL_SECONDS=2
