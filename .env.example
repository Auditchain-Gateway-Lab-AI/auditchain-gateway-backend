# Copy this file to .env for local development. Never commit the real .env.

PORT=8080
DB_DSN=postgres://postgres:password@localhost:5433/test_blockchain?sslmode=disable
JWT_SECRET=replace-with-a-long-local-secret
ADMIN_SECRET=replace-with-a-long-admin-secret

# MinIO local defaults. Replace all passwords before staging/production.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-local-root-password
MINIO_BUCKET=auditchain-recovery
MINIO_WRITER_USER=auditchain-writer
MINIO_WRITER_PASSWORD=replace-local-writer-password
MINIO_READER_USER=auditchain-reader
MINIO_READER_PASSWORD=replace-local-reader-password
# Runtime credentials when Gateway is started outside Compose (`go run main.go`).
MINIO_ACCESS_KEY=auditchain-writer
MINIO_SECRET_KEY=replace-local-writer-password
MINIO_RETENTION_MODE=GOVERNANCE
MINIO_RETENTION_DAYS=30
MINIO_USE_TLS=false
APP_ENV=local

# 32-byte key in base64 or 64 hexadecimal characters.
SNAPSHOT_ENCRYPTION_ACTIVE_KEY_ID=key-2026-01
SNAPSHOT_ENCRYPTION_KEY=replace-with-base64-or-hex-32-byte-key

# Recovery feature flags (enabled only after the implementation is complete).
RECOVERY_ENABLED=false
SNAPSHOT_WRITER_ENABLED=false
SNAPSHOT_REQUIRED_FOR_ANCHOR=false
SNAPSHOT_WORKER_CONCURRENCY=1
SNAPSHOT_MAX_ATTEMPTS=10
SNAPSHOT_RETRY_BASE_SECONDS=5
SNAPSHOT_POLL_INTERVAL_SECONDS=2
