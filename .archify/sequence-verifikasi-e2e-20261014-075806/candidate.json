  "cards": [
    {
      "dot": "emerald",
      "title": "Lulus pada contoh Morbis",
      "items": [
        "Contoh uji yang dikirim: is_valid=true, agent_status=matched, source_status=MATCHED",
        "Artinya hash/proof cocok dengan Fabric dan data live Agent berhasil dicocokkan"
      ]
    },
    {
      "dot": "amber",
      "title": "Pemeriksaan memiliki gerbang",
      "items": [
        "Hash log berbeda: berhenti dengan failed_local",
        "Hash atau anchor belum siap: hasil pending",
        "Root hasil proof berbeda dari anchor: failed_onchain",
        "Agent live dicek hanya untuk log client terbaru non-RECOVERY"
      ]
    },
    {
      "dot": "cyan",
      "title": "Baca tiga status secara terpisah",
      "items": [
        "is_valid menunjukkan integritas log Gateway dan bukti Fabric",
        "agent_status menunjukkan apakah Agent merespons dan hasil prosesnya",
        "source_status=MATCHED baru berarti data client cocok; 401/403 menjadi NOT_COMPARABLE, timeout menjadi UNREACHABLE",
        "Karena itu HTTP success atau is_valid=true saja belum membuktikan data Agent cocok"
      ]
    }
