  "cards": [
    {
      "dot": "cyan",
      "title": "Bukti on-chain",
      "items": [
        "Fabric menyimpan Merkle root dan metadata anchor; payload audit dan proof tetap dibaca dari PostgreSQL.",
        "Verifikasi Gateway menghitung ulang hash lokal, merekonstruksi root dari proof, lalu membandingkannya dengan root hasil query Fabric."
      ]
    },
    {
      "dot": "emerald",
      "title": "Batas recovery langsung",
      "items": [
        "Gateway tidak mengirim SQL ke database klien; pembacaan dan perintah pemulihan melewati Agent yang dikonfigurasi.",
        "Hasil Agent belum menutup recovery: Gateway menunggu CDC yang cocok, meng-anchor RecoveryEvent, lalu memverifikasi event tersebut."
      ]
    }
  ]
